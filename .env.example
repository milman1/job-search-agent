# Anthropic API key for job scoring (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Supabase project URL + service-role key (Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Discord webhook for score >= 7 alerts (channel settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=

# --- Cover letters (optional) ------------------------------------------------
# Generate a tailored cover letter from your resume for each strong match and
# provide it (saved to cover-letters/ and posted to Discord). Enable with the
# --cover-letters flag or COVER_LETTERS=1. Uses PROFILE_PATH / RESUME_PATH and
# APPLY_THRESHOLD / APPLY_MAX below.
COVER_LETTERS=
# Directory for generated cover letter files (default: ./cover-letters).
COVER_LETTER_DIR=

# --- Auto-apply (optional) ---------------------------------------------------
# Prepare tailored, review-ready applications from your resume for strong
# matches. Enable with the --apply flag or AUTO_APPLY=1.
AUTO_APPLY=
# Path to your profile JSON and resume text (defaults: profile.json / resume.txt).
PROFILE_PATH=
RESUME_PATH=
# Only prepare applications for matches scoring >= this (default: 7).
APPLY_THRESHOLD=
# Max applications to prepare per run (default: 5).
APPLY_MAX=
# Submission backend: "prepare" (default, review-and-submit yourself) or
# "greenhouse-api" (requires the EMPLOYER'S Greenhouse Board Token — usually
# only available to ATS owners; job seekers should leave this on prepare).
APPLY_MODE=
GREENHOUSE_BOARD_TOKEN=
