# Anthropic API key for job scoring (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Supabase project URL + service-role key (Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Discord webhook for score >= 7 alerts (channel settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=

# --- Cover letters (optional) ------------------------------------------------
# Generate a tailored cover letter from your resume for each strong match and
# provide it (saved to cover-letters/ and posted to Discord). Enable with the
# --cover-letters flag or COVER_LETTERS=1. Uses PROFILE_PATH / RESUME_PATH and
# APPLY_THRESHOLD / APPLY_MAX below.
COVER_LETTERS=
# Directory for generated cover letter files (default: ./cover-letters).
COVER_LETTER_DIR=

# --- Auto-apply (optional) ---------------------------------------------------
# Prepare tailored applications from your resume for strong matches. Enable with
# the --apply flag or AUTO_APPLY=1. A cover letter is only generated/attached
# when the application actually requires one.
AUTO_APPLY=
# Path to your profile JSON (default: profile.json).
PROFILE_PATH=
# The resume file uploaded into forms in browser mode (e.g. resume.pdf). If it's
# a PDF, its text is also extracted for the AI, so a single PDF is all you need.
RESUME_FILE=
# Optional explicit text source (.txt/.md/.pdf). Defaults to RESUME_FILE (when a
# PDF) or resume.txt. Set this only if your upload file and AI text differ.
RESUME_PATH=
# Only apply to matches scoring >= this (default: 7).
APPLY_THRESHOLD=
# Max applications per run (default: 5) and per day across runs (default: 3).
APPLY_MAX=
APPLY_DAILY_MAX=
# Submission backend:
#   prepare        (default) build a review-ready packet, you submit yourself
#   browser        fill the form + upload resume in a cloud browser, then hand
#                  you a phone link to solve the captcha and submit (Browserbase)
#   greenhouse-api POST via the EMPLOYER'S Greenhouse Board Token (ATS owners)
APPLY_MODE=
GREENHOUSE_BOARD_TOKEN=

# Browser mode (APPLY_MODE=browser) — hosted cloud browser via Browserbase.
BROWSERBASE_API_KEY=
# Optional — Browserbase infers the project from your API key when omitted.
BROWSERBASE_PROJECT_ID=
# Max session lifetime in seconds (default 3600).
BROWSERBASE_TIMEOUT=
# Auto-solve captchas in the cloud browser (default on; set 0 to disable).
BROWSERBASE_SOLVE_CAPTCHAS=
# keepAlive keeps the session alive after the run exits so you can finish from
# your phone later. PAID Browserbase feature — leave off (0) on the free plan.
BROWSERBASE_KEEP_ALIVE=
# FREE-PLAN options (sessions end when the run disconnects), pick one:
#  - Review window: hold the session open N seconds after filling so you can
#    submit via the live link while it's still alive (e.g. 300). 0 = disabled.
BROWSER_REVIEW_WINDOW=
#  - Auto-submit: after filling + solving the captcha, click Submit for a fully
#    hands-off apply (sends the application WITHOUT your review). Set 1 to enable.
BROWSER_AUTO_SUBMIT=
